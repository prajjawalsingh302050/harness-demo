# Copy to .env and fill in. .env is git-ignored.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: model to try first (e.g. gemini-3.8-flash), or an exact comma-separated order (a,b).
# Empty = newest stable "flash" first, then other flash and pro models as fallbacks.
GEMINI_MODEL=

# Optional: live deployment to measure in addition to the local server
APP_URL=
